<?xml version="1.0" encoding="UTF-8"?>

<OberliPreset name="Backing Vocals Smooth" author="Oberli Audio" category="Backing"
              description="Several singers at once: a wider band and Smooth, so the stack does not flutter."
              pluginVersion="0.1.0" created="2026-11-01" factory="true">
  <LessSState version="1" dspVersion="1">
    <PARAMETERS>
      <PARAM id="frequency" value="7000"/>
      <PARAM id="width" value="1.6"/>
      <PARAM id="threshold" value="-32"/>
      <PARAM id="range" value="5"/>
      <PARAM id="mode" value="1"/>
      <PARAM id="autoLearn" value="1"/>
      <PARAM id="relative" value="0"/>
      <PARAM id="speed" value="2"/>
      <PARAM id="lookahead" value="0"/>
      <PARAM id="listen" value="0"/>
      <PARAM id="stereo" value="0"/>
      <PARAM id="mix" value="100"/>
      <PARAM id="bypass" value="0"/>
    </PARAMETERS>
    <Extra/>
  </LessSState>
</OberliPreset>
