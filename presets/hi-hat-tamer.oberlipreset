<?xml version="1.0" encoding="UTF-8"?>

<OberliPreset name="Hi-Hat Tamer" author="Oberli Audio" category="Instruments"
              description="Overheads: the band high and wide, per channel, Auto off (it looks for a voice)."
              pluginVersion="0.1.0" created="2026-11-01" factory="true">
