<?xml version="1.0" encoding="UTF-8"?>

<OberliPreset name="Acoustic Guitar Squeak" author="Oberli Audio" category="Instruments"
              description="A narrow band on string squeaks, deep and fast; Auto off."
              pluginVersion="0.1.0" created="2026-11-01" factory="true">
  <LessSState version="1" dspVersion="1">
    <PARAMETERS>
      <PARAM id="frequency" value="5000"/>
      <PARAM id="width" value="0.8"/>
      <PARAM id="threshold" value="-34"/>
      <PARAM id="range" value="12"/>
      <PARAM id="mode" value="1"/>
      <PARAM id="autoLearn" value="0"/>
      <PARAM id="relative" value="0"/>
      <PARAM id="speed" value="0"/>
      <PARAM id="lookahead" value="0"/>
      <PARAM id="listen" value="0"/>
      <PARAM id="stereo" value="0"/>
      <PARAM id="mix" value="100"/>
      <PARAM id="bypass" value="0"/>
    </PARAMETERS>
    <Extra/>
  </LessSState>
</OberliPreset>
