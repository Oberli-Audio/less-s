{
  "version": "0.2.0",
  "configurations": [
    { "name": "Debug: Standalone (Mac)", "type": "lldb", "request": "launch",
      "program": "${command:cmake.launchTargetPath}", "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build debug" },
    { "name": "Debug: harness render (Mac)", "type": "lldb", "request": "launch",
      "program": "${command:cmake.launchTargetPath}", "args": ["--seconds=2", "--out=/tmp/render.wav"], "cwd": "${workspaceFolder}" },
    { "name": "Attach: Ableton Live 11/12 native (Mac)", "type": "lldb", "request": "attach",
      "program": "/Applications/Ableton Live 12 Suite.app/Contents/MacOS/Live", "waitFor": false },
    { "name": "Attach: Ableton Live (Windows)", "type": "cppvsdbg", "request": "attach",
      "processId": "${command:pickProcess}" }
  ]
}
